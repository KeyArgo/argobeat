---
/**
 * ArgoBeatPlayer — main player orchestrator.
 *
 * Composes MoodSelector, WaveVisualizer, SessionTimer, and VolumeControls
 * into a cohesive player interface. Imports and manages the ArgoBeatEngine
 * lifecycle, routing events between the engine and child components.
 *
 * The engine is initialized lazily on first Play click (user gesture required
 * for AudioContext) and emits state via window CustomEvents so all child
 * components stay in sync without tight coupling.
 */
import MoodSelector from './ModeSelector.astro';
import WaveVisualizer from './WaveVisualizer.astro';
import SessionTimer from './SessionTimer.astro';
import VolumeControls from './VolumeControls.astro';
import AnalysisPanel from '../AnalysisPanel.astro';

/**
 * Eligible soundscape categories per mood (build-time, matches engine affinities).
 * Used to render the soundscape dropdown options.
 */
const soundscapeCategories = [
  { value: 'noise', label: 'Brown noise / pink noise' },
  { value: 'gongs', label: 'Gongs / singing bowls / chimes' },
  { value: 'rain', label: 'Rain / weather' },
  { value: 'ocean', label: 'Ocean / coast / whales' },
  { value: 'birds', label: 'Birds / dawn chorus' },
  { value: 'forest', label: 'Forest / insects / night' },
  { value: 'jungle', label: 'Jungle / frogs / night' },
  { value: 'stream', label: 'Rivers / streams / waterfall' },
  { value: 'cave', label: 'Cave / resonance' },
  { value: 'wind', label: 'Wind / breeze' },
  { value: 'fire', label: 'Fire / fireplace' },
  { value: 'thunder', label: 'Thunder / storms' },
  { value: 'space', label: 'Space / drone' },
  { value: 'cafe', label: 'Cafe / city' },
];
---

<div class="player-shell" id="player-shell">
  <!-- Mood Selection -->
  <section class="player-section">
    <MoodSelector />
  </section>

  <!-- Source Toggle + Soundscape Selector -->
  <section class="player-section source-section">
    <div class="source-row">
      <div class="source-toggle" role="tablist" aria-label="Audio source">
        <button class="source-tab" role="tab" aria-selected="false" data-source="soundscape" id="tab-soundscapes">
          Soundscapes
        </button>
        <button class="source-tab active" role="tab" aria-selected="true" data-source="both" id="tab-both">
          Both
        </button>
        <button class="source-tab" role="tab" aria-selected="false" data-source="music" id="tab-music">
          Music
        </button>
        <button class="source-tab" role="tab" aria-selected="false" data-source="generated" id="tab-generated" title="Infinite AI synthesis — no files, never repeats">
          Generated
        </button>
        <button class="source-tab" role="tab" aria-selected="false" data-source="generated+soundscape" id="tab-generated-sc" title="Generated music blended with soundscape">
          Gen + Ambience
        </button>
      </div>
      <div class="soundscape-picker">
        <label for="soundscape-select" class="sr-only">Soundscape</label>
        <select id="soundscape-select" aria-label="Select soundscape">
          <option value="auto">Auto (broader nature mix for this mood)</option>
          {soundscapeCategories.map((sc) => (
            <option value={sc.value}>{sc.label}</option>
          ))}
        </select>
        <div class="soundscape-helper">
          Rotates across rain, ocean, rivers, trees, birds, crickets, and night-insect beds where the current catalog fits the selected mood.
        </div>
      </div>
      <div class="boost-panel" id="boost-panel" hidden>
        <button class="boost-chip" id="btn-boost" type="button" aria-pressed="false">
          Sprint boost
        </button>
        <div class="boost-helper" id="boost-helper">
          Adds a denser pulse and stronger ambient layer for focus and deep-work sessions. Works best with headphones. No medical claims.
        </div>
      </div>
      <div class="modulation-panel" id="modulation-panel">
        <div class="modulation-row">
          <span class="modulation-label">Modulation</span>
          <div class="mod-target-pills" role="group" aria-label="Modulation target">
            <button class="mod-pill active" data-target="off">Off</button>
            <button class="mod-pill" data-target="music">Music</button>
            <button class="mod-pill" data-target="soundscape">Ambience</button>
            <button class="mod-pill" data-target="both">Both</button>
          </div>
        </div>
        <div class="modulation-row" id="mod-depth-row" style="display:none;">
          <label class="modulation-label" for="modulation-depth">
            Depth <span class="modulation-value" id="modulation-value">100%</span>
          </label>
          <input type="range" id="modulation-depth" min="0" max="150" value="100"
            class="modulation-slider" aria-label="Modulation depth" />
        </div>
        <div class="boost-helper" id="mod-helper">
          Off = no AM modulation on any layer.
        </div>
      </div>
    </div>
  </section>

  <!-- Visualizer -->
  <section class="player-section">
    <WaveVisualizer />
  </section>

  <!-- Transport Controls -->
  <section class="player-section controls-section">
    <div class="transport-controls">
      <button class="transport-btn stop-btn" id="btn-stop" disabled aria-label="Stop">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <rect x="6" y="6" width="12" height="12" rx="2" />
        </svg>
      </button>
      <button class="transport-btn play-btn" id="btn-play" aria-label="Play">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
      </button>
      <button class="transport-btn pause-btn" id="btn-pause" disabled aria-label="Pause">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
        </svg>
      </button>
      <button class="transport-btn skip-btn" id="btn-skip" disabled aria-label="Skip to next track or soundscape">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M16 6h2v12h-2V6zM6 18l8.5-6L6 6v12z" />
        </svg>
      </button>
    </div>
    <div class="status-line" id="status-line">Select a mood and press play</div>
    <!-- Track card — expands when playing -->
    <div class="track-card" id="track-card" style="display:none;">
      <div class="track-card-header" id="track-card-toggle">
        <div class="track-card-title-row">
          <span class="track-card-name" id="tc-name"></span>
          <span class="track-card-neural" id="tc-neural"></span>
        </div>
        <span class="track-card-genre" id="tc-genre"></span>
        <span class="track-card-chevron" id="tc-chevron">▾</span>
      </div>
      <div class="track-card-body" id="track-card-body" style="display:none;">
        <div class="tc-row"><span class="tc-label">Mental State</span><span class="tc-value" id="tc-state"></span></div>
        <div class="tc-row"><span class="tc-label">Activity</span><span class="tc-value" id="tc-activity"></span></div>
        <div class="tc-row"><span class="tc-label">Moods</span><span class="tc-value tc-tags" id="tc-moods"></span></div>
        <div class="tc-row"><span class="tc-label">Instrumentation</span><span class="tc-value tc-tags" id="tc-instruments"></span></div>
        <div class="tc-row tc-row-inline">
          <span><span class="tc-label">Complexity</span> <span class="tc-value" id="tc-complexity"></span></span>
          <span><span class="tc-label">Brightness</span> <span class="tc-value" id="tc-brightness"></span></span>
          <span><span class="tc-label">Duration</span> <span class="tc-value" id="tc-duration"></span></span>
        </div>
      </div>
    </div>
    <div class="feedback-bar" id="feedbackBar" style="display: none;">
      <button class="thumbs-btn thumbs-up" id="thumbsUp" title="I like this track">👍</button>
      <button class="thumbs-btn thumbs-down" id="thumbsDown" title="Not for me">👎</button>
      <span class="learning-progress" id="learningProgress"></span>
    </div>
  </section>

  <!-- Audio Analysis Panel (hidden by default) -->
  <div class="analysis-toggle-row">
    <button class="analysis-toggle-btn" id="analysis-toggle-btn" type="button" aria-expanded="false">
      Show Analysis
    </button>
  </div>
  <section class="player-section" id="analysis-section" style="display:none;">
    <AnalysisPanel />
  </section>

  <!-- Gemma 4 Advisor -->
  <section class="player-section" id="advisor-section" style="display:none;">
    <div class="advisor-card" id="advisor-card">
      <div class="advisor-header">
        <span class="advisor-badge">Gemma 4</span>
        <span class="advisor-status" id="advisor-status">Watching your session…</span>
        <label class="advisor-auto-label" for="advisor-auto">
          <input type="checkbox" id="advisor-auto" />
          <span>Auto</span>
        </label>
        <button class="advisor-ask-btn" id="advisor-ask" title="Ask Gemma 4 now">Ask now</button>
      </div>
      <div class="advisor-suggestion" id="advisor-suggestion"></div>
      <div class="advisor-actions" id="advisor-actions" style="display:none;">
        <button class="advisor-btn advisor-apply" id="advisor-apply">Apply</button>
        <button class="advisor-btn advisor-dismiss" id="advisor-dismiss">Dismiss</button>
      </div>
    </div>
  </section>

  <!-- Audio Debug Panel (opt-in, hidden by default) -->
  <section class="player-section" id="debug-section">
    <div class="debug-card" id="debug-card">
      <div class="debug-header">
        <span class="debug-badge">Debug Listen</span>
        <label class="debug-toggle-label" for="debug-toggle" aria-label="Enable audio debug recording">
          <input type="checkbox" id="debug-toggle" class="debug-toggle-input" />
          <span class="debug-toggle-track"></span>
        </label>
        <span class="debug-status" id="debug-status">Off</span>
      </div>
      <div class="debug-panel" id="debug-panel" style="display:none;">
        <div class="debug-actions">
          <button class="debug-chip" id="debug-am-off" type="button">AM Off</button>
          <button class="debug-chip" id="debug-am-preset" type="button">30% Preset</button>
        </div>
        <div class="debug-params" id="debug-params">Modulation state unavailable.</div>
        <div class="debug-result" id="debug-result">Waiting for audio chunk…</div>
        <textarea class="debug-note-input" id="debug-note-input" rows="3" placeholder="Validation note: perceptible, distracting, fatiguing, disappears after 90 seconds…"></textarea>
        <div class="debug-note-row">
          <button class="debug-chip" id="debug-save-note" type="button">Save note</button>
          <span class="debug-note-status" id="debug-note-status">No note saved.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Timer -->
  <section class="player-section">
    <SessionTimer />
  </section>

  <!-- Volume Controls -->
  <section class="player-section">
    <VolumeControls />
  </section>
</div>

<script>
  import { ArgoBeatEngine } from '@argobeat/engine';

  // ── State ──
  let engine: ArgoBeatEngine | null = null;
  let selectedMood: string = 'focus';
  let selectedSoundscape: string = 'auto';
  let selectedSource: 'soundscape' | 'music' | 'both' | 'generated' | 'generated+soundscape' = 'both';
  let stimulationBoost = false;
  let activeSource: 'soundscape' | 'music' | 'both' | 'generated' | 'generated+soundscape' = 'both';
  let currentTrackId: string | null = null;
  let isPlaying = false;
  let isPaused = false;
  let currentSessionId: string | null = null;

  function safeStorageGet(key: string): string | null {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function safeStorageSet(key: string, value: string): void {
    try {
      localStorage.setItem(key, value);
    } catch {
      /* storage unavailable */
    }
  }

  function safeStorageRemove(key: string): void {
    try {
      localStorage.removeItem(key);
    } catch {
      /* storage unavailable */
    }
  }

  let advisorAutoMode = safeStorageGet('argobeat-advisor-auto') === '1';

  const ANALYSIS_API = {
    sessionStart: '/api/audio-analyze/session-start',
    sessionStop: '/api/audio-analyze/session-stop',
    sessionNote: '/api/audio-analyze/session-note',
    recommendationApplied: '/api/audio-analyze/recommendations-applied',
  };
  const FOCUS_30_PERCENT_AM_DEPTH = 0.30;
  const MOOD_BASE_AM_DEPTH: Record<string, number> = {
    focus: 0.30,
    deepWork: 0.35,
    relax: 0.20,
    meditate: 0.12,
    sleep: 0.06,
  };

  // ── DOM Refs ──
  const btnPlay = document.getElementById('btn-play') as HTMLButtonElement;
  const btnPause = document.getElementById('btn-pause') as HTMLButtonElement;
  const btnStop = document.getElementById('btn-stop') as HTMLButtonElement;
  const btnSkip = document.getElementById('btn-skip') as HTMLButtonElement;
  const btnBoost = document.getElementById('btn-boost') as HTMLButtonElement | null;
  const boostPanel = document.getElementById('boost-panel') as HTMLDivElement | null;
  const statusLine = document.getElementById('status-line')!;
  const trackMeta  = document.getElementById('track-meta') as HTMLElement;
  const soundscapeSelect = document.getElementById('soundscape-select') as HTMLSelectElement;

  // ── Track card elements ──
  const trackCard     = document.getElementById('track-card') as HTMLElement;
  const trackCardBody = document.getElementById('track-card-body') as HTMLElement;
  const tcToggle      = document.getElementById('track-card-toggle') as HTMLElement;
  const tcChevron     = document.getElementById('tc-chevron') as HTMLElement;
  let cardExpanded    = false;

  tcToggle?.addEventListener('click', () => {
    cardExpanded = !cardExpanded;
    trackCardBody.style.display = cardExpanded ? '' : 'none';
    tcChevron.textContent = cardExpanded ? '▴' : '▾';
  });

  function showTrackMeta(trackId: string | null): void {
    if (!trackMeta) return;
    const state = engine?.getState();
    if (!trackId) {
      trackMeta.textContent = '';
      if (trackCard) trackCard.style.display = 'none';
      return;
    }
    const trackName = formatTrackName(trackId) || 'Current track';

    // Compact one-line summary
    const parts: string[] = [trackName];
    if (state?.audioSource) parts.push(state.audioSource === 'soundscape' ? 'Soundscape' : state.audioSource === 'both' ? 'Blended' : 'Music');
    trackMeta.textContent = parts.join('  •  ');

    // Full card
    if (!trackCard) return;
    const set = (id: string, val: string) => {
      const el = document.getElementById(id); if (el) el.textContent = val;
    };
    const setTags = (id: string, arr: string[]) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.innerHTML = arr.map(t => `<span class="tag">${t}</span>`).join('');
    };

    const moodLabel = MOOD_LABELS[state?.mood ?? selectedMood] ?? selectedMood;
    const sourceLabel = state?.audioSource ?? selectedSource;
    set('tc-name', trackName);
    set('tc-neural', `${moodLabel} session`);
    set('tc-genre', sourceLabel === 'soundscape' ? 'Soundscape' : sourceLabel === 'both' ? 'Blended mix' : 'Music');
    set('tc-state', moodLabel);
    set('tc-activity', sourceLabel === 'soundscape' ? 'Ambient session' : sourceLabel === 'both' ? 'Layered session' : 'Music session');
    setTags('tc-moods', [moodLabel, sourceLabel]);
    setTags('tc-instruments', state?.soundscapeCategory ? [formatTrackName(state.soundscapeCategory)] : []);
    set('tc-complexity', '—');
    set('tc-brightness', '—');
    set('tc-duration', '—');

    trackCard.style.display = '';
  }

  // ── Mood labels for status display ──
  const MOOD_LABELS: Record<string, string> = {
    focus: 'Focus',
    deepWork: 'Deep Work',
    relax: 'Relax',
    meditate: 'Meditate',
    sleep: 'Sleep',
  };

  function formatTrackName(trackId: string | null): string {
    if (!trackId || trackId === 'procedural-fallback') return '';
    return trackId
      .replace(/^(lofi|cosmic)-/, '')
      .replace(/-(focus|deep|relax|meditate|sleep)$/, '')
      .replace(/-/g, ' ')
      .replace(/\b\w/g, (letter) => letter.toUpperCase());
  }

  function preferredSourceForMood(mood: string): 'soundscape' | 'music' | 'both' | 'generated' | 'generated+soundscape' {
    return (mood === 'sleep' || mood === 'meditate') ? 'soundscape' : 'both';
  }

  function isSoundscapeOnlyMood(mood: string): boolean {
    return mood === 'sleep' || mood === 'meditate';
  }

  function supportsStimulationBoost(mood: string, source: 'soundscape' | 'music' | 'both'): boolean {
    return !isSoundscapeOnlyMood(mood) && source !== 'soundscape';
  }

  function syncBoostUi(): void {
    const eligible = supportsStimulationBoost(selectedMood, selectedSource);
    if (!eligible) {
      stimulationBoost = false;
    }
    if (boostPanel) boostPanel.hidden = !eligible;
    if (btnBoost) {
      btnBoost.disabled = !eligible;
      btnBoost.classList.toggle('active', eligible && stimulationBoost);
      btnBoost.setAttribute('aria-pressed', eligible && stimulationBoost ? 'true' : 'false');
    }
  }

  function formatSoundscapeName(category: string | null, variation: string | null): string {
    if (!category) return '';
    const categoryName = formatTrackName(category);
    const variationName = formatTrackName(variation);
    return variationName ? `${categoryName} - ${variationName}` : categoryName;
  }

  function updateNowPlayingStatus(state = engine?.getState()): void {
    const moodName = MOOD_LABELS[selectedMood] || selectedMood;
    const trackName = formatTrackName(state?.currentMusicTrack ?? null);
    const soundscapeName = formatSoundscapeName(
      state?.soundscapeCategory ?? null,
      state?.currentVariation ?? null,
    );
    const layers = [soundscapeName, trackName].filter(Boolean);

    statusLine.textContent = layers.length
      ? `Playing: ${moodName} - ${layers.join(' + ')}`
      : `Playing: ${moodName}`;
  }

  // ── Valid soundscape categories (must match SoundscapeCategory type) ──
  const VALID_CATEGORIES = new Set([
    'auto', 'rain', 'ocean', 'forest', 'cafe', 'fire', 'space', 'stream', 'wind', 'thunder', 'gongs', 'jungle',
    'noise', 'birds', 'cave',
  ]);

  function resetSoundscapeToAuto(): void {
    selectedSoundscape = 'auto';
    soundscapeSelect.value = 'auto';
    safeStorageRemove('argobeat-soundscape');
  }

  function emitSessionState(): void {
    window.dispatchEvent(new CustomEvent('argobeat:sessionState', {
      detail: { sessionId: currentSessionId, isPlaying, isPaused, mood: selectedMood, source: selectedSource },
    }));
  }

  async function startRemoteSession(state = engine?.getState()): Promise<void> {
    try {
      const res = await fetch(ANALYSIS_API.sessionStart, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          mood: selectedMood,
          source: state?.audioSource ?? selectedSource,
          initial_track: state?.currentMusicTrack ?? null,
          initial_soundscape: state?.soundscapeCategory ?? selectedSoundscape ?? null,
        }),
      });
      if (!res.ok) return;
      const data = await res.json() as { sessionId?: string };
      currentSessionId = data.sessionId ?? null;
      emitSessionState();
    } catch {
      currentSessionId = null;
      emitSessionState();
    }
  }

  async function stopRemoteSession(status: 'completed' | 'stopped'): Promise<void> {
    const sessionId = currentSessionId;
    currentSessionId = null;
    emitSessionState();
    if (!sessionId) return;
    try {
      await fetch(ANALYSIS_API.sessionStop, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ session_id: sessionId, status }),
      });
    } catch {
      /* best-effort only */
    }
  }

  async function saveSessionNote(note: string, metadata: Record<string, unknown> = {}): Promise<boolean> {
    if (!currentSessionId || !note.trim()) return false;
    try {
      const res = await fetch(ANALYSIS_API.sessionNote, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          session_id: currentSessionId,
          note: note.trim(),
          note_type: 'am_validation',
          metadata,
        }),
      });
      return res.ok;
    } catch {
      return false;
    }
  }

  async function markRecommendationApplied(recommendationId?: string): Promise<void> {
    if (!recommendationId) return;
    try {
      await fetch(ANALYSIS_API.recommendationApplied, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ recommendation_id: recommendationId }),
      });
    } catch {
      /* best-effort only */
    }
  }

  // Soundscapes should start from the mood's best-fit automatic pool.
  resetSoundscapeToAuto();

  // ── Engine Initialization (lazy, on first user gesture) ──
  async function ensureEngine(): Promise<ArgoBeatEngine> {
    if (!engine) {
      engine = new ArgoBeatEngine();
      // Expose a cleanup hook so version-switch can stop audio before
      // the ClientRouter view-transition swaps the DOM
      (window as any).__argobeatEngine = engine;
      await engine.initialize();

      // Forward analyser to visualizer + analysis panel
      const analyser = engine.getAnalyser();
      if (analyser) {
        window.dispatchEvent(
          new CustomEvent('argobeat-engine-ready', {
            detail: { analyser },
          })
        );
        // Also fire the analysis panel event
        window.dispatchEvent(
          new CustomEvent('argobeat:engineReady', { detail: { analyser } })
        );
      }

      // Wire engine events to window CustomEvents for child components
      // Also drive local transport state from engine state to prevent race conditions
      engine.on('stateChange', (state) => {
        isPlaying = state.isPlaying;
        isPaused = state.isPaused;
        activeSource = state.audioSource ?? activeSource;
        currentTrackId = state.currentMusicTrack ?? null;
        // Forward state to analysis panel
        window.dispatchEvent(new CustomEvent('argobeat:stateChange', { detail: state }));
        updateTransport(state.isPlaying || state.isPaused, state.isPaused);

        window.dispatchEvent(
          new CustomEvent('argobeat-state-change', {
            detail: {
              isPlaying: state.isPlaying,
              isPaused: state.isPaused,
              mood: state.mood ?? selectedMood,
            },
          })
        );
        emitSessionState();
      });

      engine.on('tick', (elapsed, total) => {
        window.dispatchEvent(
          new CustomEvent('argobeat-tick', {
            detail: { elapsedSeconds: elapsed, sessionSeconds: total },
          })
        );
      });

      engine.on('musicTrackChange', (_from, to) => {
        currentTrackId = to;
        updateNowPlayingStatus();
        showTrackMeta(to);
      });

      engine.on('variationChange', () => {
        updateNowPlayingStatus();
      });

      engine.on('sessionComplete', () => {
        statusLine.textContent = 'Session complete';
        updateTransport(false, false);
        trackSession('complete', selectedMood);
        void stopRemoteSession('completed');
      });

      engine.on('error', (err) => {
        console.error('[ArgoBeat]', err);
        statusLine.textContent = 'Audio error — try refreshing';
      });
    }
    return engine;
  }

  // ── Transport Actions ──

  async function startPlayback() {
    try {
      const eng = await ensureEngine();

      // Play with optional soundscape category override (validate first)
      const playOptions: { category?: any; stimulationBoost?: boolean } = {};
      if (selectedSoundscape !== 'auto' && VALID_CATEGORIES.has(selectedSoundscape) && selectedSoundscape !== 'auto') {
        playOptions.category = selectedSoundscape;
      }
      if (stimulationBoost && supportsStimulationBoost(selectedMood, selectedSource)) {
        playOptions.stimulationBoost = true;
      }

      await eng.play(selectedMood as any, { ...playOptions, source: selectedSource });
      activeSource = eng.getState().audioSource ?? selectedSource;
      // State (isPlaying/isPaused) is now driven by engine stateChange event

      // Re-send analyser ref (graph is rebuilt on each play call)
      const analyser = eng.getAnalyser();
      if (analyser) {
        window.dispatchEvent(new CustomEvent('argobeat-engine-ready', { detail: { analyser } }));
        // Analysis panel — fires here so analyser is guaranteed non-null
        window.dispatchEvent(new CustomEvent('argobeat:engineReady', { detail: { analyser } }));
      }

      // Enforce modulation pill state — engine starts at 0 depth, UI is source of truth
      applyModulation();

      updateNowPlayingStatus(eng.getState());

      // Show feedback bar for rating
      showFeedbackBar();

      await startRemoteSession(eng.getState());

      // Track session start (localStorage, privacy-first)
      trackSession('start', selectedMood);
    } catch (err) {
      console.error('[ArgoBeat] Play failed:', err);
      statusLine.textContent = 'Failed to start — tap to retry';
    }
  }

  function doPause() {
    if (!engine) return;
    engine.pause();
    // State updated by engine stateChange event
    statusLine.textContent = 'Paused';
  }

  function doResume() {
    if (!engine) return;
    engine.resume();
    // State updated by engine stateChange event
    updateNowPlayingStatus();
  }

  function doStop() {
    if (!engine) return;

    // Track if user stopped early
    const state = engine.getState();
    if (state.elapsedSeconds > 10) {
      trackSession('stopped', selectedMood);
    }

    engine.stop();
    // State updated by engine stateChange event
    statusLine.textContent = 'Select a mood and press play';
    hideFeedbackBar();
    void stopRemoteSession('stopped');
  }

  async function doSkip() {
    if (!engine || !isPlaying) return;

    const state = engine.getState();
    const liveSource = state.audioSource ?? activeSource ?? selectedSource;

    if (liveSource === 'both') {
      const [musicSkipped, soundscapeSkipped] = await Promise.all([
        engine.skipMusic(),
        engine.skipSoundscape(),
      ]);

      if (musicSkipped && soundscapeSkipped) {
        statusLine.textContent = 'Skipping to a fresh mix...';
        showFeedbackBar();
        return;
      }
      if (musicSkipped) {
        statusLine.textContent = 'Skipping to next music...';
        showFeedbackBar();
        return;
      }
      if (soundscapeSkipped) {
        statusLine.textContent = 'Skipping to next soundscape...';
        return;
      }

      statusLine.textContent = 'No alternate mix available right now';
      return;
    }

    if (liveSource === 'music') {
      const skipped = await engine.skipMusic();
      statusLine.textContent = skipped
        ? 'Skipping to next music...'
        : 'No alternate music track available';
      if (skipped) showFeedbackBar();
      return;
    }

    const soundscapeSkipped = await engine.skipSoundscape();
    if (soundscapeSkipped) {
      statusLine.textContent = 'Skipping to next soundscape...';
      return;
    }

    const musicFallback = state.currentMusicTrack ? await engine.skipMusic() : false;
    statusLine.textContent = musicFallback
      ? 'Soundscape unavailable, skipping music instead...'
      : 'No alternate soundscape available';
    if (musicFallback) showFeedbackBar();
  }

  function updateTransport(playing: boolean, paused: boolean) {
    btnPlay.disabled = playing && !paused;
    btnPause.disabled = !playing;
    btnStop.disabled = !playing && !paused;
    btnSkip.disabled = !playing;

    // Visual state on play button
    btnPlay.classList.toggle('active-glow', playing && !paused);
  }

  // ── Session Tracking (localStorage, privacy-first) ──

  function trackSession(action: string, moodId: string) {
    try {
      const stats = JSON.parse(localStorage.getItem('argobeat-stats') || '{}');
      if (!stats.totalSessions) stats.totalSessions = 0;
      if (!stats.totalMinutes) stats.totalMinutes = 0;
      if (!stats.moods) stats.moods = {};

      if (action === 'complete' || action === 'stopped') {
        const state = engine?.getState();
        stats.totalSessions++;
        stats.totalMinutes += Math.round((state?.elapsedSeconds ?? 0) / 60);
        stats.moods[moodId] = (stats.moods[moodId] || 0) + 1;
        stats.lastSession = new Date().toISOString();
      }

      localStorage.setItem('argobeat-stats', JSON.stringify(stats));
    } catch {
      /* localStorage unavailable */
    }
  }

  // ── AudioContext global unlock ────────────────────────────────────────────
  // Pre-warm on any user interaction so the context is always ready by the
  // time play is pressed. iOS Safari is especially strict about this.
  const unlockAudio = () => {
    if (engine) {
      engine.getAudioContext()?.resume().catch(() => {});
    } else {
      // Context doesn't exist yet — create it silently so it starts in running state
      try {
        const tmpCtx = new AudioContext();
        tmpCtx.resume().then(() => tmpCtx.close());
      } catch { /* ignore */ }
    }
  };
  document.addEventListener('touchstart', unlockAudio, { once: true, passive: true });
  document.addEventListener('click',      unlockAudio, { once: true });

  // ── Event Bindings ──

  btnPlay.addEventListener('click', () => {
    // Unlock AudioContext synchronously while still in the user-gesture window.
    // Browsers suspend new AudioContexts until the first gesture; if resume()
    // is deferred into an async chain it may lose the gesture and stay suspended.
    engine?.getAudioContext()?.resume().catch(() => {});

    if (isPaused) doResume();
    else if (!isPlaying) startPlayback();
  });

  btnPause.addEventListener('click', () => {
    if (isPlaying && !isPaused) doPause();
    else if (isPaused) doResume();
  });

  btnStop.addEventListener('click', () => doStop());

  btnSkip.addEventListener('click', () => {
    void doSkip();
  });

  // ── Thumbs Up/Down Feedback System ──

  const PREFS_KEY = 'argobeat-user-preferences';
  const LEARNING_THRESHOLD = 10;
  const feedbackBar = document.getElementById('feedbackBar');
  const thumbsUp = document.getElementById('thumbsUp') as HTMLButtonElement;
  const thumbsDown = document.getElementById('thumbsDown') as HTMLButtonElement;
  const learningProgress = document.getElementById('learningProgress');

  function loadPrefs() {
    try {
      const stored = safeStorageGet(PREFS_KEY);
      return stored ? JSON.parse(stored) : {
        version: '2.0', createdAt: Date.now(), updatedAt: Date.now(),
        feedbackCount: { thumbsUp: 0, thumbsDown: 0 }, trackRatings: []
      };
    } catch { return { version: '2.0', createdAt: Date.now(), updatedAt: Date.now(), feedbackCount: { thumbsUp: 0, thumbsDown: 0 }, trackRatings: [] }; }
  }

  function savePrefs(prefs: any) {
    prefs.updatedAt = Date.now();
    safeStorageSet(PREFS_KEY, JSON.stringify(prefs));
  }

  function updateLearningUI() {
    if (!learningProgress) return;
    const prefs = loadPrefs();
    const count = prefs.feedbackCount.thumbsUp;
    if (count < LEARNING_THRESHOLD) {
      learningProgress.textContent = `Teaching ArgoBeat: ${count}/${LEARNING_THRESHOLD}`;
    } else {
      learningProgress.textContent = '✓ Adapting to your preferences';
    }
  }

  function rateTrack(rating: 'up' | 'down') {
    const prefs = loadPrefs();
    const trackId = currentTrackId ?? `${selectedMood}-${Date.now()}`;
    prefs.trackRatings.push({ id: trackId, mood: selectedMood, rating, timestamp: Date.now() });
    if (rating === 'up') prefs.feedbackCount.thumbsUp++;
    else prefs.feedbackCount.thumbsDown++;
    savePrefs(prefs);

    // Visual feedback: disable buttons, highlight chosen
    thumbsUp.disabled = true;
    thumbsDown.disabled = true;
    if (rating === 'up') thumbsUp.classList.add('rated');
    else thumbsDown.classList.add('rated');
    updateLearningUI();
  }

  function showFeedbackBar() {
    if (feedbackBar) feedbackBar.style.display = 'flex';
    thumbsUp.disabled = false;
    thumbsDown.disabled = false;
    thumbsUp.classList.remove('rated');
    thumbsDown.classList.remove('rated');
    updateLearningUI();
  }

  function hideFeedbackBar() {
    if (feedbackBar) feedbackBar.style.display = 'none';
  }

  thumbsUp?.addEventListener('click', () => rateTrack('up'));
  thumbsDown?.addEventListener('click', () => rateTrack('down'));

  soundscapeSelect.addEventListener('change', () => {
    selectedSoundscape = VALID_CATEGORIES.has(soundscapeSelect.value) ? soundscapeSelect.value : 'auto';
    soundscapeSelect.value = selectedSoundscape;
      safeStorageRemove('argobeat-soundscape');
    // If currently playing, restart with the new soundscape
    if (isPlaying && engine) {
      doStop();
      setTimeout(() => startPlayback(), 150);
    }
  });

  // Source toggle: Soundscapes / Both / Music
  const sourceTabs = document.querySelectorAll<HTMLButtonElement>('.source-tab');
  const soundscapePicker = document.querySelector<HTMLElement>('.soundscape-picker');

  function setSourceMode(source: 'soundscape' | 'music' | 'both' | 'generated' | 'generated+soundscape'): void {
    selectedSource = isSoundscapeOnlyMood(selectedMood) ? 'soundscape' : source;
    sourceTabs.forEach((tab) => {
      const tabSource = tab.dataset.source;
      const disabled = isSoundscapeOnlyMood(selectedMood) && tabSource !== 'soundscape';
      const active = tabSource === selectedSource;
      tab.disabled = disabled;
      tab.title = disabled ? 'Sleep and meditation use soundscapes only until suitable music is approved.' : '';
      tab.classList.toggle('active', active);
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
      tab.setAttribute('aria-disabled', disabled ? 'true' : 'false');
    });

    if (soundscapePicker) {
      soundscapePicker.style.display = selectedSource === 'music' ? 'none' : '';
    }

    syncBoostUi();
  }

  sourceTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      if (tab.disabled) return;
      const source = tab.dataset.source as 'soundscape' | 'music' | 'both' | 'generated' | 'generated+soundscape' | undefined;
      setSourceMode(source || preferredSourceForMood(selectedMood));
      safeStorageRemove('argobeat-source');

      // If playing, restart with new source mode
      if (isPlaying && engine) {
        doStop();
        setTimeout(() => startPlayback(), 150);
      }
    });
  });

  btnBoost?.addEventListener('click', () => {
    if (!supportsStimulationBoost(selectedMood, selectedSource)) return;
    stimulationBoost = !stimulationBoost;

    // If turning ON while in music-only mode, switch to both so soundscape activates
    if (stimulationBoost && selectedSource === 'music') {
      setSourceMode('both');
      // Need restart when switching source mode
      if (isPlaying && engine) { doStop(); setTimeout(() => startPlayback(), 150); }
    } else {
      syncBoostUi();
      // Update gains live — no restart needed when toggling within same source mode
      if (engine) engine.setStimulationBoost(stimulationBoost);
    }
  });

  // ── Modulation depth slider ───────────────────────────────────────────────
  // ── Modulation controls ───────────────────────────────────────────
  const modulationSlider = document.getElementById('modulation-depth') as HTMLInputElement | null;
  const modulationValue  = document.getElementById('modulation-value') as HTMLElement | null;
  const modDepthRow      = document.getElementById('mod-depth-row') as HTMLElement | null;
  const modHelper        = document.getElementById('mod-helper') as HTMLElement | null;

  let modTarget: 'off' | 'music' | 'soundscape' | 'both' = 'off';

  const MOD_HELPERS: Record<string, string> = {
    off:        'Off — no AM modulation on any layer.',
    music:      'Music — rhythmic pulse applied to the music track at chosen depth.',
    soundscape:'Ambience — soundscape routed through the modulation chain.',
    both:       'Both — AM modulation on music and soundscape simultaneously.',
  };

  function applyModulation(): void {
    if (!engine) return;
    const depthPct = modulationSlider ? parseInt(modulationSlider.value, 10) : 100;
    const scale = depthPct / 100; // 0 = none, 1.5 = 150% of mood default

    if (modTarget === 'off') {
      engine.setModulateSoundscape(0);
      engine.setMusicModulationScale(0);
    } else if (modTarget === 'music') {
      engine.setModulateSoundscape(0);
      engine.setMusicModulationScale(scale);
    } else if (modTarget === 'soundscape') {
      engine.setModulateSoundscape(scale);
      engine.setMusicModulationScale(0);
    } else { // both
      engine.setModulateSoundscape(scale);
      engine.setMusicModulationScale(scale);
    }
    updateDebugParams();
  }

  document.querySelectorAll('.mod-pill').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.mod-pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      modTarget = (btn as HTMLElement).dataset.target as typeof modTarget;
      const showSlider = modTarget !== 'off';
      if (modDepthRow) modDepthRow.style.display = showSlider ? '' : 'none';
      if (modHelper) modHelper.textContent = MOD_HELPERS[modTarget];
      applyModulation();
      updateDebugParams();
    });
  });

  modulationSlider?.addEventListener('input', () => {
    const pct = parseInt(modulationSlider.value, 10);
    if (modulationValue) modulationValue.textContent = `${pct}%`;
    applyModulation();
    updateDebugParams();
  });

  // Default every fresh visit to blended music + auto-best soundscape.
  safeStorageRemove('argobeat-source');
  setSourceMode(preferredSourceForMood(selectedMood));

  window.addEventListener('argobeat-mood-select', ((e: CustomEvent) => {
    selectedMood = e.detail.mood;
    resetSoundscapeToAuto();
    setSourceMode(preferredSourceForMood(selectedMood));
    if (isPlaying || isPaused) {
      doStop();
      // Brief delay then restart with new mood
      setTimeout(() => startPlayback(), 150);
    }
  }) as EventListener);

  window.addEventListener('argobeat-volume-change', ((e: CustomEvent) => {
    if (engine) {
      engine.setVolume(e.detail.master);
    }
  }) as EventListener);

  // ── Analysis panel: apply generative parameter suggestions ──────────────
  window.addEventListener('argobeat:applyGenerativeParams', ((e: CustomEvent) => {
    const params = e.detail as Record<string, number>;
    if (!engine) return;
    // Route to generative engine via the engine's internal reference
    // The engine exposes this via a custom event forwarded to GenerativeEngine
    for (const [key, val] of Object.entries(params)) {
      window.dispatchEvent(new CustomEvent('argobeat:setGenerativeParam', { detail: { key, val } }));
    }
  }) as EventListener);

  // ── Gemma 4 Advisor ──────────────────────────────────────────────────────

  const advisorSection = document.getElementById('advisor-section') as HTMLElement;
  const advisorStatus = document.getElementById('advisor-status') as HTMLElement;
  const advisorSuggestion = document.getElementById('advisor-suggestion') as HTMLElement;
  const advisorActions = document.getElementById('advisor-actions') as HTMLElement;
  const advisorApply = document.getElementById('advisor-apply') as HTMLButtonElement;
  const advisorDismiss = document.getElementById('advisor-dismiss') as HTMLButtonElement;
  const advisorAskBtn = document.getElementById('advisor-ask') as HTMLButtonElement;
  const advisorAuto = document.getElementById('advisor-auto') as HTMLInputElement;

  interface AdvisorPrimaryAction {
    kind: 'soundscape' | 'music' | 'boost_on' | 'boost_off' | 'modulation';
    params?: { category?: string; percent?: number; target?: 'music' | 'soundscape' | 'both' };
  }

  interface AiAdvisorResult {
    suggestion: string;
    primaryAction?: AdvisorPrimaryAction;
    autoApply: boolean;
    source: 'gemma4' | 'local-fallback';
    recommendationId?: string;
  }

  interface PendingAdvisorAction {
    action?: AdvisorPrimaryAction;
    recommendationId?: string;
  }

  advisorAuto.checked = advisorAutoMode;

  function getCurrentModulationPercent(): number {
    return modulationSlider ? parseInt(modulationSlider.value, 10) : 0;
  }

  function localAdvisorSuggestion(mood: string, soundscape: string, elapsedMin: number): AiAdvisorResult {
    const trackName = formatTrackName(currentTrackId);
    const hasTrack = Boolean(trackName);

    if (!hasTrack && selectedSource !== 'soundscape') {
      return {
        suggestion: 'The music layer did not land cleanly. Refresh the track before changing the rest of the scene.',
        primaryAction: { kind: 'music' },
        autoApply: false,
        source: 'local-fallback',
      };
    }

    if ((mood === 'focus' || mood === 'deepWork') && soundscape === 'thunder') {
      return {
        suggestion: 'The storm layer is a bit too aggressive for sustained work. Forest is the safer masking bed.',
        primaryAction: { kind: 'soundscape', params: { category: 'forest' } },
        autoApply: true,
        source: 'local-fallback',
      };
    }

    if (mood === 'relax') {
      return {
        suggestion: 'Keep the mix gentle. If it starts to feel crowded, ocean is the cleanest small shift.',
        primaryAction: soundscape === 'auto' ? { kind: 'soundscape', params: { category: 'ocean' } } : undefined,
        autoApply: true,
        source: 'local-fallback',
      };
    }

    return {
      suggestion: elapsedMin >= 8
        ? `You have momentum. Hold the current scene a bit longer and only refresh the track if focus starts to flatten out.`
        : `${trackName || 'The current scene'} is stable enough for now. Leave it alone unless it starts pulling attention.`,
      primaryAction: elapsedMin >= 8 ? { kind: 'music' } : undefined,
      autoApply: false,
      source: 'local-fallback',
    };
  }

  async function fetchAdvisorSuggestion(mood: string, soundscape: string, elapsedMin: number): Promise<AiAdvisorResult> {
    try {
      const state = engine?.getState();
      const res = await fetch('/api/ai-advisor', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          session_id: currentSessionId,
          mood,
          soundscape,
          elapsed_minutes: elapsedMin,
          current_track: formatTrackName(currentTrackId),
          modulation_percent: getCurrentModulationPercent(),
          sprint_boost_active: stimulationBoost,
          brightness: undefined,
        }),
      });
      if (res.ok) {
        const data = await res.json() as AiAdvisorResult;
        if (data.suggestion) return data;
      }
    } catch {
      /* fall through */
    }
    return localAdvisorSuggestion(mood, soundscape, elapsedMin);
  }

  let advisorTimer: number | null = null;
  let pendingAdvisor: PendingAdvisorAction = {};
  let advisorThinking = false;

  function actionButtonLabel(action?: AdvisorPrimaryAction): string {
    if (!action) return 'Apply';
    if (action.kind === 'soundscape') return `Switch to ${formatTrackName(action.params?.category ?? '')}`;
    if (action.kind === 'music') return 'Fresh Track';
    if (action.kind === 'boost_on') return 'Engage Boost';
    if (action.kind === 'boost_off') return 'Ease Boost';
    if (action.kind === 'modulation') return `Use ${action.params?.percent ?? 0}% Modulation`;
    return 'Apply';
  }

  async function executeAdvisorAction(action?: AdvisorPrimaryAction, recommendationId?: string): Promise<boolean> {
    if (!action) return false;

    if (action.kind === 'soundscape') {
      const category = action.params?.category;
      if (!category || !VALID_CATEGORIES.has(category)) return false;
      selectedSoundscape = category;
      soundscapeSelect.value = category;
      advisorStatus.textContent = `Applied — switched to ${category}`;
      if (isPlaying && engine) { doStop(); setTimeout(() => startPlayback(), 150); }
      await markRecommendationApplied(recommendationId);
      return true;
    }

    if (action.kind === 'music' && engine && isPlaying) {
      advisorStatus.textContent = 'Applied — skipping to a fresh track';
      await engine.skipMusic();
      await markRecommendationApplied(recommendationId);
      return true;
    }

    if (action.kind === 'boost_on') {
      stimulationBoost = true;
      syncBoostUi();
      engine?.setStimulationBoost(true);
      advisorStatus.textContent = 'Applied — sprint boost engaged';
      await markRecommendationApplied(recommendationId);
      return true;
    }

    if (action.kind === 'boost_off') {
      stimulationBoost = false;
      syncBoostUi();
      engine?.setStimulationBoost(false);
      advisorStatus.textContent = 'Applied — sprint boost eased';
      await markRecommendationApplied(recommendationId);
      return true;
    }

    if (action.kind === 'modulation') {
      const target = action.params?.target ?? 'both';
      modTarget = target;
      document.querySelectorAll('.mod-pill').forEach((btn) => {
        btn.classList.toggle('active', (btn as HTMLElement).dataset.target === target);
      });
      if (modDepthRow) modDepthRow.style.display = target === 'off' ? 'none' : '';
      if (modHelper) modHelper.textContent = MOD_HELPERS[target];
      if (modulationSlider && typeof action.params?.percent === 'number') {
        modulationSlider.value = String(action.params.percent);
        if (modulationValue) modulationValue.textContent = `${action.params.percent}%`;
      }
      applyModulation();
      advisorStatus.textContent = `Applied — modulation set to ${action.params?.percent ?? getCurrentModulationPercent()}%`;
      await markRecommendationApplied(recommendationId);
      return true;
    }

    return false;
  }

  async function showAdvisorSuggestion(result: AiAdvisorResult): Promise<void> {
    advisorSuggestion.textContent = result.suggestion;
    pendingAdvisor = { action: result.primaryAction, recommendationId: result.recommendationId };
    advisorApply.textContent = actionButtonLabel(result.primaryAction);
    advisorActions.style.display = result.primaryAction ? 'flex' : 'none';
    advisorStatus.textContent = result.primaryAction
      ? `${result.source === 'gemma4' ? 'Gemma 4' : 'Fallback'} suggestion ready`
      : 'Watching your session…';
    advisorAskBtn.disabled = false;
    advisorThinking = false;

    if (
      advisorAutoMode &&
      result.autoApply &&
      result.primaryAction &&
      result.primaryAction.kind !== 'music'
    ) {
      advisorActions.style.display = 'none';
      await executeAdvisorAction(result.primaryAction, result.recommendationId);
      pendingAdvisor = {};
    }
  }

  function advisorThink() {
    if (advisorThinking) return;
    advisorThinking = true;
    advisorStatus.textContent = 'Thinking…';
    advisorSuggestion.textContent = '';
    advisorActions.style.display = 'none';
    advisorAskBtn.disabled = true;
    if (advisorTimer) { clearTimeout(advisorTimer); advisorTimer = null; }

    const elapsed = engine ? Math.round(engine.getState().elapsedSeconds / 60) : 0;
    fetchAdvisorSuggestion(selectedMood, selectedSoundscape, elapsed).then(async (result) => {
      if (!isPlaying) { advisorThinking = false; return; }
      await showAdvisorSuggestion(result);
      advisorTimer = window.setTimeout(advisorThink, 5 * 60 * 1000);
    });
  }

  function startAdvisor() {
    advisorSection.style.display = '';
    advisorStatus.textContent = 'Watching your session…';
    advisorSuggestion.textContent = '';
    advisorActions.style.display = 'none';
    advisorAskBtn.disabled = false;
    advisorThinking = false;
    if (advisorTimer) clearTimeout(advisorTimer);
    advisorTimer = window.setTimeout(advisorThink, 20 * 1000);
  }

  function stopAdvisor() {
    if (advisorTimer) { clearTimeout(advisorTimer); advisorTimer = null; }
    advisorThinking = false;
    advisorSection.style.display = 'none';
    advisorSuggestion.textContent = '';
    pendingAdvisor = {};
  }

  advisorAuto?.addEventListener('change', () => {
    advisorAutoMode = advisorAuto.checked;
    safeStorageSet('argobeat-advisor-auto', advisorAutoMode ? '1' : '0');
  });

  advisorAskBtn?.addEventListener('click', () => {
    if (!advisorThinking) advisorThink();
  });

  advisorApply?.addEventListener('click', async () => {
    if (!pendingAdvisor.action) {
      advisorActions.style.display = 'none';
      return;
    }
    advisorActions.style.display = 'none';
    await executeAdvisorAction(pendingAdvisor.action, pendingAdvisor.recommendationId);
    pendingAdvisor = {};
  });

  advisorDismiss?.addEventListener('click', () => {
    advisorSuggestion.textContent = '';
    advisorActions.style.display = 'none';
    advisorStatus.textContent = 'Watching your session…';
    pendingAdvisor = {};
  });

  window.addEventListener('argobeat-state-change', ((e: CustomEvent) => {
    if (e.detail.isPlaying && !e.detail.isPaused) {
      if (advisorSection.style.display === 'none') startAdvisor();
    } else if (!e.detail.isPlaying && !e.detail.isPaused) {
      stopAdvisor();
    }
  }) as EventListener);

  // ── Audio Debug Hook ────────────────────────────────────────────────────────

  // Analysis panel toggle
  const analysisToggleBtn = document.getElementById('analysis-toggle-btn') as HTMLButtonElement;
  const analysisSection   = document.getElementById('analysis-section')   as HTMLElement;
  if (analysisToggleBtn && analysisSection) {
    analysisToggleBtn.addEventListener('click', () => {
      const open = analysisSection.style.display !== 'none';
      analysisSection.style.display = open ? 'none' : '';
      analysisToggleBtn.textContent  = open ? 'Show Analysis' : 'Hide Analysis';
      analysisToggleBtn.setAttribute('aria-expanded', String(!open));
    });
  }

  const debugToggle  = document.getElementById('debug-toggle')  as HTMLInputElement;
  const debugStatus  = document.getElementById('debug-status')  as HTMLElement;
  const debugPanel   = document.getElementById('debug-panel')   as HTMLElement;
  const debugResult  = document.getElementById('debug-result')  as HTMLElement;
  const debugParams  = document.getElementById('debug-params')  as HTMLElement;
  const debugAmOff   = document.getElementById('debug-am-off')  as HTMLButtonElement;
  const debugAmPreset = document.getElementById('debug-am-preset') as HTMLButtonElement;
  const debugNoteInput = document.getElementById('debug-note-input') as HTMLTextAreaElement;
  const debugSaveNote = document.getElementById('debug-save-note') as HTMLButtonElement;
  const debugNoteStatus = document.getElementById('debug-note-status') as HTMLElement;

  let debugRecorder:   MediaRecorder | null = null;
  let debugStreamDest: MediaStreamAudioDestinationNode | null = null;
  let debugActive = false;

  function updateDebugParams(): void {
    const baseDepth = MOOD_BASE_AM_DEPTH[selectedMood] ?? MOOD_BASE_AM_DEPTH.focus;
    const sliderPct = getCurrentModulationPercent();
    const scale = sliderPct / 100;
    const target = modTarget;
    const musicDepth = target === 'music' || target === 'both'
      ? Math.min(baseDepth * 0.5 * scale, 0.25)
      : 0;
    const soundscapeDepth = target === 'soundscape' || target === 'both'
      ? Math.min(baseDepth * (0.8 + scale * 2.4), 0.45)
      : 0;
    debugParams.textContent = `Mood=${selectedMood} · target=${target} · slider=${sliderPct}% · base AM=${Math.round(baseDepth * 100)}% · music depth≈${musicDepth.toFixed(3)} · soundscape depth≈${soundscapeDepth.toFixed(3)} · session=${currentSessionId ?? 'none'}`;
  }

  function applyThirtyPercentPreset(): void {
    const baseDepth = MOOD_BASE_AM_DEPTH[selectedMood] ?? MOOD_BASE_AM_DEPTH.focus;
    const scaledPct = Math.round(Math.min(150, Math.max(0, (FOCUS_30_PERCENT_AM_DEPTH / baseDepth) * 100)));
    modTarget = 'both';
    document.querySelectorAll('.mod-pill').forEach((btn) => {
      btn.classList.toggle('active', (btn as HTMLElement).dataset.target === 'both');
    });
    if (modDepthRow) modDepthRow.style.display = '';
    if (modHelper) modHelper.textContent = MOD_HELPERS.both;
    if (modulationSlider) {
      modulationSlider.value = String(scaledPct);
      if (modulationValue) modulationValue.textContent = `${scaledPct}%`;
    }
    applyModulation();
    debugNoteStatus.textContent = '30% bandpass preset armed for this mood.';
  }

  function scheduleNextChunk() {
    if (!debugActive || !debugRecorder || !debugStreamDest) return;
    const chunks: BlobPart[] = [];
    debugRecorder.ondataavailable = (e) => { if (e.data.size > 0) chunks.push(e.data); };
    debugRecorder.onstop = async () => {
      if (!debugActive) return;
      const blob = new Blob(chunks, { type: 'audio/webm' });
      debugResult.textContent = 'Analyzing…';
      try {
        const res = await fetch('/api/audio-debug', { method: 'POST', body: blob });
        if (res.ok) {
          const data = await res.json() as { analysis?: string };
          debugResult.textContent = data.analysis ?? 'No analysis returned';
        } else {
          debugResult.textContent = `Analysis failed (${res.status})`;
        }
      } catch {
        debugResult.textContent = 'Network error during analysis';
      }
      debugStatus.textContent = 'Listening…';
      scheduleNextChunk();
    };
    debugRecorder.start();
    setTimeout(() => { if (debugRecorder?.state === 'recording') debugRecorder.stop(); }, 10_000);
  }

  function startDebugListen() {
    const analyser = engine?.getAnalyser();
    if (!analyser) {
      debugStatus.textContent = 'No audio — start playback first';
      debugToggle.checked = false;
      return;
    }
    const ctx = analyser.context as AudioContext;
    debugStreamDest = ctx.createMediaStreamDestination();
    analyser.connect(debugStreamDest);

    const mimeType = MediaRecorder.isTypeSupported('audio/webm;codecs=opus')
      ? 'audio/webm;codecs=opus'
      : 'audio/webm';
    debugRecorder = new MediaRecorder(debugStreamDest.stream, { mimeType });
    debugActive = true;
    debugPanel.style.display = '';
    debugStatus.textContent = 'Recording first chunk…';
    updateDebugParams();
    scheduleNextChunk();
  }

  function stopDebugListen() {
    debugActive = false;
    if (debugRecorder && debugRecorder.state !== 'inactive') {
      debugRecorder.ondataavailable = null;
      debugRecorder.onstop = null;
      debugRecorder.stop();
    }
    debugRecorder = null;
    if (debugStreamDest) {
      try { engine?.getAnalyser()?.disconnect(debugStreamDest); } catch { /* ok */ }
      debugStreamDest = null;
    }
    debugStatus.textContent = 'Off';
    debugPanel.style.display = 'none';
    debugResult.textContent = 'Waiting for audio chunk…';
  }

  debugAmOff?.addEventListener('click', () => {
    modTarget = 'off';
    document.querySelectorAll('.mod-pill').forEach((btn) => {
      btn.classList.toggle('active', (btn as HTMLElement).dataset.target === 'off');
    });
    if (modDepthRow) modDepthRow.style.display = 'none';
    if (modHelper) modHelper.textContent = MOD_HELPERS.off;
    applyModulation();
    updateDebugParams();
    debugNoteStatus.textContent = 'AM modulation turned off for A/B testing.';
  });

  debugAmPreset?.addEventListener('click', () => {
    applyThirtyPercentPreset();
  });

  debugSaveNote?.addEventListener('click', async () => {
    const note = debugNoteInput.value.trim();
    if (!note) {
      debugNoteStatus.textContent = 'Enter a note first.';
      return;
    }
    const saved = await saveSessionNote(note, {
      mood: selectedMood,
      modTarget,
      modulationPercent: getCurrentModulationPercent(),
      playing: isPlaying,
      source: selectedSource,
    });
    debugNoteStatus.textContent = saved ? 'Validation note saved to the current session.' : 'Could not save note.';
    if (saved) debugNoteInput.value = '';
  });

  debugToggle?.addEventListener('change', () => {
    if (debugToggle.checked) startDebugListen();
    else stopDebugListen();
  });

  // Stop debug recorder when engine stops so chunks aren't dangling
  window.addEventListener('argobeat-state-change', ((e: CustomEvent) => {
    if (!e.detail.isPlaying && !e.detail.isPaused && debugToggle.checked) {
      stopDebugListen();
      debugToggle.checked = false;
    }
  }) as EventListener);

  window.addEventListener('argobeat:sessionState', (() => {
    updateDebugParams();
  }) as EventListener);

  updateDebugParams();
  emitSessionState();
</script>

