---
export interface Props {
  currentPage?: string;
}

const { currentPage = '' } = Astro.props;
---

<nav class="navbar" role="navigation" aria-label="Main navigation">
  <div class="navbar-inner">
    <a href="/" class="navbar-brand" aria-label="ArgoBeat home">
      <svg class="brand-icon" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <circle cx="14" cy="14" r="12" stroke="currentColor" stroke-width="2" />
        <path d="M8 14 Q14 6 20 14 Q14 22 8 14Z" fill="currentColor" opacity="0.6" />
      </svg>
      <span>ArgoBeat</span>
    </a>

    <div class="navbar-links">
      <a href="/app" class:list={[{ active: currentPage === 'app' }]}>App</a>
      <a href="/science" class:list={[{ active: currentPage === 'science' }]}>Science</a>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg-glass);
    backdrop-filter: blur(var(--blur-glass));
    border-bottom: 1px solid var(--color-border-glass);
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    height: 60px;
  }

  .navbar-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    font-weight: 700;
    font-size: 20px;
    color: var(--color-text-primary);
    transition: opacity 0.2s;
  }

  .navbar-brand:hover {
    opacity: 0.9;
  }

  .brand-icon {
    color: var(--color-accent);
  }

  .navbar-links {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 28px;
  }

  .navbar-links a {
    color: var(--color-text-secondary);
    font-size: 15px;
    font-weight: 500;
    transition: color 0.2s;
    text-decoration: none;
  }

  .navbar-links a:hover,
  .navbar-links a.active {
    color: var(--color-accent);
    opacity: 1;
  }

  @media (max-width: 640px) {
    .navbar {
      width: 100vw;
      max-width: 100vw;
      overflow: hidden;
    }

    .navbar-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      width: 100vw;
      max-width: 100vw;
      padding: 0 16px;
      height: 52px;
      gap: 12px;
    }

    .navbar-brand {
      font-size: 18px;
      overflow: hidden;
    }

    .navbar-links {
      position: absolute;
      right: 16px;
      top: 50%;
      transform: translateY(-50%);
      gap: 14px;
    }

    .navbar-links a {
      font-size: 13px;
    }
  }
</style>
