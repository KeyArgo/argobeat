{
  "name": "argobeat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter argobeat-web dev",
    "build": "pnpm --filter @argobeat/engine type-check && pnpm --filter argobeat-web build",
    "preview": "pnpm --filter argobeat-web preview",
    "type-check": "pnpm -r type-check",
    "catalog:validate": "tools/argobeat validate-catalog",
    "audio:validate": "python3 tools/validate_audio_manifest.py",
    "audio:ingest": "python3 tools/ingest_audio.py",
    "audio:analyze": "python3 tools/analyze_audio.py",
    "audio:demo": "./tools/argobeat demo-export",
    "catalog:analyze": "python3 tools/analyze_catalog.py"
  },
  "devDependencies": {
    "node-web-audio-api": "^1.0.9",
    "wav-encoder": "^1.3.0"
  }
}
